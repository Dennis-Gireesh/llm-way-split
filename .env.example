# The web application binds to loopback by default outside Docker.
WAYSPLIT_HOST=127.0.0.1
WAYSPLIT_PORT=9876
WAYSPLIT_DATA_DIR=./data

# Comma-separated local model endpoints. The app probes both Ollama and
# OpenAI-compatible model-list endpoints without sending statement data.
WAYSPLIT_MODEL_ENDPOINTS=http://127.0.0.1:11434,http://127.0.0.1:8080

# Optional credential for an explicitly configured model endpoint.
WAYSPLIT_MODEL_API_KEY=
WAYSPLIT_MODEL_TIMEOUT_SECONDS=300

# Source documents are deleted after extraction unless this is explicitly enabled.
WAYSPLIT_RETAIN_SOURCE=false
WAYSPLIT_MAX_UPLOAD_MIB=25
WAYSPLIT_MAX_PAGES=24
WAYSPLIT_RECONCILIATION_TOLERANCE=0.00
WAYSPLIT_MINIMUM_EXTRACTION_CONFIDENCE=0.80
WAYSPLIT_REQUIRE_CHARGE_EVIDENCE=true

# Set this only when placing WaySplit behind a trusted HTTPS reverse proxy.
WAYSPLIT_ALLOWED_ORIGINS=http://127.0.0.1:9876,http://localhost:9876
WAYSPLIT_TRUST_PROXY_HEADERS=false
